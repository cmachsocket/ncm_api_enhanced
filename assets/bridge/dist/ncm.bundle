  "homepage": "https://github.com/holepunchto/bare-performance#readme",
  "engines": {
    "bare": ">=1.27.0"
  },
  "dependencies": {
    "bare-events": "^2.9.1"
  },
  "devDependencies": {
    "brittle": "^3.13.1",
    "cmake-bare": "^1.5.4",
    "cmake-fetch": "^1.4.7",
    "lunte": "^1.8.4",
    "prettier": "^3.5.3",
    "prettier-config-holepunch": "^2.0.0"

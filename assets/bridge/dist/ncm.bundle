                    timeScale: Token.UINT32_BE.get(buf, off + 12),
                    duration: Token.UINT32_BE.get(buf, off + 16),
                    language: Token.UINT16_BE.get(buf, off + 20),
                    quality: Token.UINT16_BE.get(buf, off + 22)
                };

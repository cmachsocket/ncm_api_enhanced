          name = 'undefined'
          break
      }
    } else if (c === '\r') {
      name = 'return'
      meta = escaped
    } else if (c === '\n') {
      name = 'linefeed'
      meta = escaped
    } else if (c === '\t') {
      name = 'tab'
      meta = escaped
    } else if (c === '\b' || c === '\x7f') {
      name = 'backspace'
      meta = escaped
    } else if (c === ESC) {
      name = 'escape'
      meta = escaped
    } else if (c === ' ') {
      name = 'space'
      meta = escaped
    } else if (!escaped && c <= '\x1a') {

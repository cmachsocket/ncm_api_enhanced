    "test:kdf": "node test/slow-kdf.test.ts",
    "test:ultra": "node test/slow-ultra.test.ts",
    "test:ultra:scrypt": "node test/slow-extreme-scrypt.test.ts"
  },
  "exports": {
    ".": "./index.js",

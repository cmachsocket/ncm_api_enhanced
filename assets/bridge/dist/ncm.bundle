        /* xterm ESC [ letter */
        case '[A':
          name = 'up'
          break
        case '[B':
          name = 'down'
          break
        case '[C':
          name = 'right'
          break
        case '[D':
          name = 'left'
          break
        case '[E':
          name = 'clear'
          break
        case '[F':
          name = 'end'
          break
        case '[H':
          name = 'home'
          break

        /* xterm/gnome ESC O letter */
        case 'OA':
          name = 'up'
          break
        case 'OB':
          name = 'down'
          break
        case 'OC':
          name = 'right'
          break
        case 'OD':
          name = 'left'
          break
        case 'OE':
          name = 'clear'
          break
        case 'OF':
          name = 'end'
          break
        case 'OH':
          name = 'home'
          break

        /* xterm/rxvt ESC [ number ~ */
        case '[1~':
          name = 'home'
          break
        case '[2~':
          name = 'insert'
          break
        case '[3~':
          name = 'delete'
          break
        case '[4~':
          name = 'end'
          break
        case '[5~':
          name = 'pageup'
          break
        case '[6~':
          name = 'pagedown'
          break


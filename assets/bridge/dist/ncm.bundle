function* parseKeys(stream) {
  while (true) {
    let c = yield
    let s = c
    let escaped = false

    let name = null
    let ctrl = false
    let meta = false
    let shift = false

    if (c === ESC) {
      escaped = true

      s += c = yield

      if (c === ESC) {
        s += c = yield
      }
    }

    if (escaped && (c === 'O' || c === '[')) {
      let code = c
      let modifier = 0

      if (c === 'O') {
        s += c = yield

        if (c >= '0' && c <= '9') {
          modifier = (c >> 0) - 1
          s += c = yield
        }

        code += c
      } else if (c === '[') {
        s += c = yield

        if (c === '[') {
          code += c
          s += c = yield
        }

        const start = s.length - 1

        if (c >= '0' && c <= '9') {
          s += c = yield

          if (c >= '0' && c <= '9') {
            s += c = yield

            if (c >= '0' && c <= '9') {
              s += c = yield

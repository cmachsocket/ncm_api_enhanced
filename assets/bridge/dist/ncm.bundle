                file_alter_preservation: util.getBit(b, 0, 6),
                read_only: util.getBit(b, 0, 5)
            },
            format: {
                compression: util.getBit(b, 1, 7),
                encryption: util.getBit(b, 1, 6),
                grouping_identity: util.getBit(b, 1, 5),

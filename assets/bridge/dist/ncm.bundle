  _onwrite(err) {
    if (this._timer) this._timer.refresh()

    this._continueWrite(err)
  }

  _onfinal(err) {
    this._continueFinal(err === null || err.code === 'ENOTCONN' ? null : err)
  }

  _onclose() {
    this._state |= constants.state.CLOSED

    clearTimeout(this._timer)

    this._continueOpen()
    this._continueDestroy()

                previewDuration: Token.UINT32_BE.get(buf, off + 88),
                posterTime: Token.UINT32_BE.get(buf, off + 92),
                selectionTime: Token.UINT32_BE.get(buf, off + 96),
                selectionDuration: Token.UINT32_BE.get(buf, off + 100),

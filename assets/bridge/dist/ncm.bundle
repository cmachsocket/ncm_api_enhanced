  _transform(data, encoding, cb) {
    clearTimeout(this._escapeTimer)

    if (data[0] > 127 && data.length === 1) {
      data[0] -= 128
      data = ESC + data.toString(this.encoding)
    } else {
      data = data.toString(this.encoding)

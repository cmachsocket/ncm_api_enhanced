        case '[200~':
          name = 'paste-start'
          break
        case '[201~':
          name = 'paste-end'
          break

        /* from Cygwin and used in libuv */
        case '[[A':
          name = 'f1'
          break
        case '[[B':
          name = 'f2'
          break
        case '[[C':
          name = 'f3'
          break
        case '[[D':
          name = 'f4'
          break
        case '[[E':
          name = 'f5'
          break

        /* common */
        case '[15~':
          name = 'f5'
          break
        case '[17~':
          name = 'f6'
          break
        case '[18~':
          name = 'f7'
          break
        case '[19~':
          name = 'f8'
          break
        case '[20~':
          name = 'f9'
          break
        case '[21~':
          name = 'f10'
          break
        case '[23~':
          name = 'f11'
          break
        case '[24~':
          name = 'f12'

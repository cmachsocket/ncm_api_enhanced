    this.lowerBoundary = 0x80
    this.upperBoundary = 0xbf
  }

  get remaining() {
    return this.bytesSeen
  }

  decode(data) {
    if (ArrayBuffer.isView(data)) {
      data = Buffer.from(data.buffer, data.byteOffset, data.byteLength)
    } else {

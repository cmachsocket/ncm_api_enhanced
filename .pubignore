# Don't ship the downloaded libnode.so binaries in the pub tarball.
# These are produced by hook/build.dart at consumer build time; if you
# commit them to the package source tree, just rerun the hook and
# exclude the result. They're ~60 MB each, and shipping them balloons
# the pub tarball to ~200 MB unnecessarily.
android/src/main/jniLibs/*/libnode.so

# NOTE: bridge/node_modules/ IS shipped with the package (see
# `tool/refresh_bridge.sh`). The dart hooks system can only ship
# single-file native code assets (CodeAsset), not JS dependency
# trees, so the JS runtime has to ride along as a Flutter asset.
# We deliberately accept the size in exchange for consumers not
# needing npm at all.

# Build / test cache directories that are generated by `flutter test`
# and `flutter pub get`. They're recreated as needed.
/build/
.dart_tool/
.idea/
*.iml
.DS_Store